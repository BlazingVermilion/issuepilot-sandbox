# Run python scripts/init_env.py to generate local secrets.
IP_MODE=demo
IP_REPO=demo/issuepilot-sandbox
IP_ENGINE=rules
IP_MODEL=qwen2.5:7b
IP_OLLAMA_URL=http://host.docker.internal:11434
IP_GITHUB_TOKEN=
IP_WRITES_ENABLED=false
IP_WEBHOOK_SECRET=GENERATE_WEBHOOK_SECRET
IP_REVIEWER_TOKENS={"maintainer":"GENERATE_REVIEWER_TOKEN"}
IP_POLICY_DIR=policies
# Optional extra restriction; omit to use repository labels intersected with policies/label_rules.json.
# IP_ALLOWED_LABELS=["bug","documentation"]
IP_ALLOWED_ASSIGNEES=[]
POSTGRES_PASSWORD=GENERATE_DATABASE_PASSWORD
N8N_ENCRYPTION_KEY=GENERATE_N8N_ENCRYPTION_KEY
# Set to the exact tested n8n image tag for deployment. Do not use 'latest'.
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.47.3
# Local non-Docker overrides: uncomment for uvicorn/worker on your host.
# IP_DATABASE_URL=sqlite:///./data/issuepilot.db
# IP_CHECKPOINT_URL=data/checkpoints.db
# IP_OLLAMA_URL=http://localhost:11434
